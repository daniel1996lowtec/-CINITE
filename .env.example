# ==============================================================================
# CI CRAFT 2.8 — PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Copy to `.env` for local overrides or configure in your hosting dashboard
# (Render, Railway, Fly.io, or VPS). Never commit real secrets to Git.
# ==============================================================================

# 1. Server Binding & Environment
NODE_ENV=production
HOST=0.0.0.0
# PORT is injected automatically by Render/Railway/Fly — do NOT set it there.
# It is only needed for local runs; when unset the server falls back to 2567.
PORT=2567

# 2. Persistent Database Configuration
# Option A (Recommended for Multi-Instance / Cloud Hosting): Managed PostgreSQL
# Example format: postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
# On Render, use the database's INTERNAL connection string (fromDatabase in
# render.yaml). Schema migrations run automatically during server startup.
DATABASE_URL=
# Optional: startup connection retries for DATABASE_URL (default 5).
DATABASE_CONNECT_RETRIES=
# Optional emergency escape hatch: set to 1 to fall back to on-disk SQLite if
# DATABASE_URL is unreachable (NOT recommended — cloud disks may be ephemeral).
DATABASE_FALLBACK_SQLITE=

# Option B (Single-Instance / Persistent Volume Fallback): On-Disk SQLite WAL
# Used automatically when DATABASE_URL is empty.
SQLITE_DB_PATH=./data/cicraft.sqlite

# 3. Account Token Signing Secret (HMAC-SHA256)
# Generate a strong 64-hex-char secret via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCOUNT_TOKEN_SECRET=

# 4. Optional CORS / WebSocket Origin Allowlist (comma-separated)
# Leave empty to allow same-origin & public browser connections, or restrict to your domain:
# ALLOWED_ORIGINS=https://your-cicraft-app.onrender.com
ALLOWED_ORIGINS=

# 5. Optional Client-Side Build Variables (only needed if hosting frontend on a separate CDN)
# Leave empty when serving the built `dist/` bundle directly from `server/multiplayerServer.mjs`
# so the client automatically uses relative HTTPS and WSS (`wss://<host>/ws`).
VITE_MULTIPLAYER_SERVER_URL=
VITE_MULTIPLAYER_WS_URL=
