# TypeScript, Vite and @types/three are devDependencies, but they are required
# to compile the production bundle. Hosting builds (Render/Railway) run with
# NODE_ENV=production, where a plain `npm ci` omits devDependencies and breaks
# the build (TS7016: missing 'three' declarations / tsc not found).
# Always include devDependencies when installing this project.
include=dev
